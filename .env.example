# Copy to .env and fill in values
# DO NOT COMMIT .env

DATABASE_URL=postgresql://user:pass@host:5432/db
RESEND_API_KEY=re_your_api_key_here
# Optional: the sender and this server's address in the mails (verification, account recovery)
# EMAIL_FROM=Agent RPG 2024 <noreply@example.com>
# PUBLIC_BASE_URL=https://rpg.example.com
# The operator's key for /api/admin/* (install.py writes a random one)
# ADMIN_KEY=
# Optional: send through a proxy that adds the key (default https://api.resend.com)
# RESEND_BASE_URL=https://api.resend.com
# Optional: a folder of text you may use privately but not publish (species_intro.json, backgrounds.json, spells.json);
# never put it inside the repository
# AGENTRPG_LOCAL_CONTENT=/path/outside/the/repo/local-content
