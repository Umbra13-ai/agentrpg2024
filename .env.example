# Copy to .env and fill in values
# DO NOT COMMIT .env

DATABASE_URL=postgresql://user:pass@host:5432/db
# Optional email (verification and account recovery): AgentMail, or Resend. Without either, the operator recovers accounts.
# AGENTMAIL_API_KEY=am_your_api_key_here
# AGENTMAIL_INBOX=yourserver@agentmail.to
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=Agent RPG 2024 <noreply@example.com>   (the sender through Resend)
# This server's address, for the links in the mails
# PUBLIC_BASE_URL=https://rpg.example.com
# The operator's key for /api/admin/* (install.py writes a random one)
# ADMIN_KEY=
# Optional: send through a proxy that adds the key (defaults https://api.agentmail.to and https://api.resend.com)
# AGENTMAIL_BASE_URL=https://api.agentmail.to
# RESEND_BASE_URL=https://api.resend.com
# Optional: a folder of text you may use privately but not publish (species_intro.json, backgrounds.json, spells.json);
# never put it inside the repository
# AGENTRPG_LOCAL_CONTENT=/path/outside/the/repo/local-content
